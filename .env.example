# SmartLine Layihəsi üçün Nümunə Konfiqurasiya
# QEYD: Əsl açarlarınızı heç vaxt GitHub-a yükləməyin!
# Tətbiq daxilində "Ayarlar -> AI Parametrləri & API Açarı" bölməsindən
# və ya "flutter run --dart-define=GROQ_API_KEY=your_key_here" əmri ilə təyin edə bilərsiniz.

# Groq API Açarınız (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini API Açarınız (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Açarınız (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
